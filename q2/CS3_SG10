class Patient:
    def __init__(self, name: str, bill_amount: float):
        self._name = name
        self._bill_amount = bill_amount

    def get_name(self) -> str:
        return self._name

    def set_name(self, name: str):
        self._name = name

    def get_bill_amount(self) -> float:
        return self._bill_amount

    def set_bill_amount(self, bill_amount: float):
        self._bill_amount = bill_amount

    def calculate_bill(self) -> float:

        return self._bill_amount


class SeniorPatient(Patient):
    def __init__(self, name: str, bill_amount: float):
        super().__init__(name, bill_amount)

    def calculate_bill(self) -> float:
       
        return self._bill_amount * 0.80


class PhilHealthPatient(Patient):
    def __init__(self, name: str, bill_amount: float):
        super().__init__(name, bill_amount)

    def calculate_bill(self) -> float:
        
        return self._bill_amount * 0.85



if __name__ == "__main__":

    regular_patient = Patient("Katleen Amistoso", 15000.0)
    senior_patient = SeniorPatient("Angel Dangcalan", 20000.0)
    philhealth_patient = PhilHealthPatient("Leighann Mutoc", 10000.0)

    patients = [regular_patient, senior_patient, philhealth_patient]

    print("--- Hospital Billing System ---")
    for p in patients:
        print(f"Patient Name: {p.get_name()}")
        print(f"Original Bill Amount: ₱{p.get_bill_amount():,.2f}")
        print(f"Final Computed Bill: ₱{p.calculate_bill():,.2f}")
        print("-" * 35)
